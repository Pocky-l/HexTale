{
  "multipart": [
    {
      "apply": {
        "model": "hextale:block/essence_tank"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "hextale:block/essence_tank_port"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "hextale:block/essence_tank_port",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "hextale:block/essence_tank_port",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "hextale:block/essence_tank_port",
        "y": 270
      }
    }
  ]
}
